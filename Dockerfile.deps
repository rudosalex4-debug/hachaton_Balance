FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake ninja-build pkg-config libdrogon-dev libpqxx-dev libsimdjson-dev libjsoncpp-dev libgtest-dev libsqlite3-dev libmariadb-dev libmariadb-dev-compat libbrotli-dev libhiredis-dev libyaml-cpp-dev libssl-dev uuid-dev zlib1g-dev ca-certificates python3 && rm -rf /var/lib/apt/lists/*



